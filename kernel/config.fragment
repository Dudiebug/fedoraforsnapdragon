# Surface Laptop 7 (Snapdragon X, X1E80100/X1P64100) on top of Fedora's aarch64 config.
# Installed as the spec's kernel-local, which process_configs.sh merges into every
# config. build-rpm.sh then checks every CONFIG_ line here against the config the
# built kernel ships (/lib/modules/<ver>/config) and fails if one is missing: that
# means a renamed option or an unmet dependency, and the device would silently vanish.
#
# Derived from couchliteos kernel/sl7/config.fragment (written for Debian's config).
# Where Fedora already builds something in (=y) that Debian has as a module, Fedora's
# choice is kept; where Fedora has a module that Debian builds in, Fedora's module is
# kept (Fedora boots X1E laptops with these as modules from the initramfs). The Debian
# build options (DEBUG_INFO_NONE, SYSTEM_TRUSTED_KEYS) are dropped: the spec owns those.

# Touch: the HID-over-SPI transport (patches/0002) for the touchpad and the SPI
# touchscreen; HID-over-I2C for the 13.8-inch I2C touchscreen (patches/0100).
CONFIG_SPI_HID=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_HID_OF=y
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_GENERIC=y

# SoC
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_X1E80100=y
CONFIG_CLK_X1E80100_GCC=y
CONFIG_CLK_X1E80100_DISPCC=m
CONFIG_CLK_X1E80100_GPUCC=m
CONFIG_CLK_X1E80100_TCSRCC=y
CONFIG_CLK_X1E80100_CAMCC=m
CONFIG_INTERCONNECT_QCOM_X1E80100=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_ARM_QCOM_CPUFREQ_HW=m
CONFIG_QCOM_TSENS=m
CONFIG_QCOM_LMH=m
CONFIG_NVMEM_QCOM_QFPROM=m
CONFIG_QCOM_SMEM=m
CONFIG_QCOM_SMP2P=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QCOM_APR=m
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_QCOM_AOSS_QMP=m
CONFIG_QCOM_SCM=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_INPUT_PM8941_PWRKEY=m
CONFIG_POWER_RESET_QCOM_PON=m
CONFIG_RTC_DRV_PM8XXX=m
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y

# Storage and buses
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=m
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_QMP_USB=m
CONFIG_PHY_QCOM_EUSB2_REPEATER=m
CONFIG_PHY_SNPS_EUSB2=m
CONFIG_PHY_QCOM_EDP=m
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_QCOM=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_TYPEC_MUX_PS883X=m
CONFIG_USB_ONBOARD_DEV=m
CONFIG_BLK_DEV_NVME=m

# Display, GPU, video decode
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_PANEL_EDP=m
CONFIG_DRM_DISPLAY_CONNECTOR=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_OV02C10=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Wi-Fi and Bluetooth (WCN7850)
CONFIG_ATH12K=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_DEV_BUS=y

# Audio. The speaker volume limit is upstream since 7.3 (sound/soc/qcom/x1e80100.c,
# snd_soc_limit_volume); build-rpm.sh checks it is still there.
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_X1E80100=m
CONFIG_SND_SOC_QCOM_SDW=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_WSA884X=m
CONFIG_SND_SOC_WCD939X=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SOUNDWIRE_QCOM=m

# Surface EC (keyboard, battery, posture events: patches/0020)
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m

# Crypto engine (patches/0026 and 0027 make it safe to enable; Fedora leaves it off)
CONFIG_CRYPTO_DEV_QCE=m
